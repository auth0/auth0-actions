{
  "name": "@auth0/actions",
  "version": "0.25.0",
  "description": "Official Auth0 Actions TypeScript definitions, which will help you code and test your project's Actions on external editors and IDEs.",
  "main": "index.js",
  "keywords": [
    "auth0",
    "actions",
    "types",
    "beta"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "notice": "node utils/generate-notice.js"
  },
  "author": "auth0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth0/auth0-actions.git"
  },
  "bugs": {
    "url": "https://support.auth0.com"
  },
  "homepage": "https://auth0.com/docs/customize/actions/actions-npm",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
